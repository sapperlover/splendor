# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging output
build/
dist/
*.egg-info/
.eggs/

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Local editor, OS, and agent metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
.agents/
.codex/

# Logs and transient files
*.log
*.tmp

# Program runtime output and failure snapshots
runtime/
failures/
web_failures/
validation_failures/
engine_validation/
evaluation_failures/
runs/
play_checkpoints/*.pt

# Resumable per-game experiment sidecars; keep only their aggregate JSON.
artifacts/**/*.games/
