# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging output
src/splendor/_native_search*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Local editor, OS, and agent metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
.agents/
.codex/

# Logs and transient files
*.log
*.tmp

# Program runtime output and failure snapshots
runtime/
failures/
web_failures/
validation_failures/
engine_validation/
evaluation_failures/
runs/
play_checkpoints/*.pt

# Resumable per-game evaluation sidecars; keep only aggregate JSON artifacts.
*.games/

prompt/*

# Generated per-generation evaluation configs (regenerated by scripts/run_az_generation_evals.py)
configs/az_loop_seed1_evals/

# patch/merge leftovers
*.orig
*.rej

ladrilho/

# Raw experimental evidence stays local or in external archives.
# Version compact summaries, protocols and source identities instead.
/artifacts/**/*.npz
/artifacts/**/*.jsonl
/artifacts/**/*.jsonl.gz
/artifacts/**/*.gpu.csv
/artifacts/**/full_holdout_step_*.json
/artifacts/**/pool_games.jsonl
/artifacts/**/panels/*.json
/artifacts/**/results/evaluation_*.json
/artifacts/**/fitting/step-*.json
/artifacts/**/root_bank.json
/artifacts/**/candidate_bank.json
/artifacts/**/root_references.json
/artifacts/**/train_references.json
/artifacts/**/holdout_predictions*.json
/artifacts/**/searches.json
/artifacts/**/root_results.json
/artifacts/**/pair_scores.json
/artifacts/**/raw/root-*.json
/archive/**/moves.jsonl
/archive/**/SHA256SUMS
/archive/**/*.jsonl
/archive/**/*.jsonl.gz

