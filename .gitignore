# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging output
build/
dist/
*.egg-info/
.eggs/

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Local editor, OS, and agent metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
.agents/
.codex/

# Logs and transient files
*.log
*.tmp

# Reproducible runtime output and failure snapshots
failures/
validation_failures/
engine_validation/

# Stress-test artifacts are reproducible. Keep only the accepted summary that
# is linked by docs/work_package_2d_engine_validation_zh-CN.md.
artifacts/*
!artifacts/work_package_2d/
artifacts/work_package_2d/*
!artifacts/work_package_2d/stress-10000-rules-v2.json
