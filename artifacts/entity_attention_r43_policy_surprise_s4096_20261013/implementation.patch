diff --git a/src/splendor/policy_surprise.py b/src/splendor/policy_surprise.py
new file mode 100644
index 0000000..294097e
--- /dev/null
+++ b/src/splendor/policy_surprise.py
@@ -0,0 +1,84 @@
+"""Policy-only surprise weighting from frozen search/teacher distributions.
+
+Adapted from KataGo's per-game uniform/surprise mixture. We deliberately use
+the archived *unnoised* root_network_prior and change only policy loss weights,
+not sampling probabilities or value weights. Validation remains unweighted.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, replace
+from typing import Mapping, Sequence
+
+import numpy as np
+
+from .alphazero_replay import ReplayReference
+from .selfplay_data import SelfPlayBatch, SelfPlaySample
+
+
+@dataclass(frozen=True)
+class PolicySurpriseConfig:
+    fraction: float = 0.5
+
+    def __post_init__(self):
+        if (isinstance(self.fraction, bool) or not isinstance(self.fraction, (int, float))
+                or not math.isfinite(self.fraction) or not 0 <= self.fraction <= 1):
+            raise ValueError("policy surprise fraction must be finite and in [0, 1]")
+
+
+def game_policy_surprise(arrays: Mapping[str, np.ndarray], config: PolicySurpriseConfig):
+    """Return KL(search || teacher) and effective weights for every game row.
+
+    A fraction of each game's searchable policy mass is redistributed in
+    proportion to KL. Forced moves retain zero policy weight. A game with no
+    surprise retains its original weights. No validation or learner prediction
+    enters the normalization, and the raw archive is never modified.
+    """
+    starts = arrays["candidate_offsets"][:-1]
+    lengths = np.diff(arrays["candidate_offsets"])
+    target = np.asarray(arrays["policy_target"], dtype=np.float64)
+    prior = np.asarray(arrays["root_network_prior"], dtype=np.float64)
+    # Stored float32 distributions sum to one within archive tolerance.
+    target = target / np.repeat(np.add.reduceat(target, starts), lengths)
+    prior = prior / np.repeat(np.add.reduceat(prior, starts), lengths)
+    log_target = np.zeros_like(target)
+    np.log(target, out=log_target, where=target > 0)
+    terms = target * (log_target - np.log(np.maximum(prior, 1e-100)))
+    surprise = np.maximum(0., np.add.reduceat(terms, starts))
+    base = np.asarray(arrays["policy_weight"], dtype=np.float64)
+    mass = float(base.sum())
+    surprise_mass = float(np.dot(base, surprise))
+    weights = base.copy()
+    if surprise_mass > 0:
+        weights *= (1 - config.fraction) + config.fraction * surprise * mass / surprise_mass
+    return surprise, weights.astype(np.float32)
+
+
+class PolicySurpriseWeighting:
+    """Small per-game weight cache; deterministic across process resumes."""
+
+    def __init__(self, config: PolicySurpriseConfig):
+        self.config = config
+        self.games = {}
+
+    def apply(self, batch: SelfPlayBatch, samples: Sequence[SelfPlaySample],
+              references: Sequence[ReplayReference]):
+        weights, surprises = [], []
+        for sample, ref in zip(samples, references, strict=True):
+            key = ref.run_id, ref.round_index, ref.game_id
+            if key not in self.games:
+                self.games[key] = game_policy_surprise(sample.arrays, self.config)
+            surprise, effective = self.games[key]
+            weights.append(effective[sample.index])
+            surprises.append(surprise[sample.index])
+        weights = np.asarray(weights, dtype=np.float32)
+        active = batch.policy_weights > 0
+        selected = weights[active].astype(np.float64)
+        mass = float(selected.sum())
+        square_mass = float(np.dot(selected, selected))
+        stats = {"fraction": self.config.fraction, "policy_weight_sum": mass,
+                 "effective_policy_positions": mass * mass / square_mass if square_mass else 0.,
+                 "mean_weight": float(selected.mean()) if len(selected) else 0.,
+                 "max_weight": float(selected.max()) if len(selected) else 0.,
+                 "mean_teacher_surprise": float(np.asarray(surprises)[active].mean()) if active.any() else 0.}
+        return replace(batch, policy_weights=weights), stats
diff --git a/tests/test_policy_surprise.py b/tests/test_policy_surprise.py
new file mode 100644
index 0000000..0aee209
--- /dev/null
+++ b/tests/test_policy_surprise.py
@@ -0,0 +1,65 @@
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from splendor.alphazero_replay import ReplayReference
+from splendor.policy_surprise import PolicySurpriseConfig, PolicySurpriseWeighting, game_policy_surprise
+from splendor.selfplay_data import SelfPlaySample
+
+
+def arrays():
+    return {"candidate_offsets": np.array([0, 2, 4, 5]),
+            "policy_target": np.array([.5, .5, 1., 0., 1.], dtype=np.float32),
+            "root_network_prior": np.array([.5, .5, .25, .75, 1.], dtype=np.float32),
+            "root_used_prior": np.array([.1, .9, .9, .1, 1.], dtype=np.float32),
+            "policy_weight": np.array([1., 1., 0.], dtype=np.float32)}
+
+
+def test_per_game_mixture_uses_unnoised_teacher_and_preserves_mass():
+    raw = arrays()
+    surprise, weights = game_policy_surprise(raw, PolicySurpriseConfig(.5))
+    np.testing.assert_allclose(surprise, [0., np.log(4.), 0.])
+    np.testing.assert_allclose(weights, [.5, 1.5, 0.])
+    assert weights.sum() == raw['policy_weight'].sum()
+    np.testing.assert_array_equal(raw['policy_weight'], [1., 1., 0.])
+    raw['root_used_prior'][:] = 0
+    np.testing.assert_array_equal(game_policy_surprise(raw, PolicySurpriseConfig(.5))[1], weights)
+
+
+def test_zero_surprise_zero_prior_and_disabled_fraction_are_finite():
+    raw = arrays()
+    raw['root_network_prior'] = raw['policy_target'].copy()
+    np.testing.assert_array_equal(game_policy_surprise(raw, PolicySurpriseConfig())[1], raw['policy_weight'])
+    raw['root_network_prior'][2:4] = [0., 1.]
+    surprise, weights = game_policy_surprise(raw, PolicySurpriseConfig())
+    assert np.isfinite(surprise).all() and np.isfinite(weights).all()
+    assert surprise[1] == pytest.approx(100 * np.log(10))
+    np.testing.assert_array_equal(game_policy_surprise(raw, PolicySurpriseConfig(0))[1], raw['policy_weight'])
+    raw['policy_weight'][:] = 0
+    np.testing.assert_array_equal(game_policy_surprise(raw, PolicySurpriseConfig())[1], 0)
+
+
+@pytest.mark.parametrize('fraction', [-1, 1.01, True, float('nan'), float('inf')])
+def test_invalid_fraction(fraction):
+    with pytest.raises(ValueError, match='fraction'):
+        PolicySurpriseConfig(fraction)
+
+
+def test_weight_cache_isolates_runs_and_changes_only_policy_batch_fields():
+    from splendor.selfplay_data import SelfPlayBatch
+    raw = arrays()
+    samples = [SelfPlaySample(raw, {}, i) for i in range(3)]
+    refs = [ReplayReference(1, 'a', 0, i) for i in range(3)]
+    batch = SelfPlayBatch(None, None, None, np.array([1, -1, 1]), raw['policy_weight'],
+                         np.ones(3), ())
+    weighter = PolicySurpriseWeighting(PolicySurpriseConfig())
+    weighted, stats = weighter.apply(batch, samples, refs)
+    assert weighted.value_weights is batch.value_weights and weighted.value_targets is batch.value_targets
+    assert weighted.policy_targets is batch.policy_targets
+    np.testing.assert_array_equal(weighted.policy_weights, [.5, 1.5, 0])
+    assert stats['effective_policy_positions'] == pytest.approx(1.6)
+    other = {**raw, 'root_network_prior': raw['policy_target'].copy()}
+    weighted, _ = weighter.apply(batch, [replace(s, arrays=other) for s in samples],
+                                [replace(r, run_id='b') for r in refs])
+    np.testing.assert_array_equal(weighted.policy_weights, raw['policy_weight'])
